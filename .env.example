# Salin ke .env lalu isi nilainya
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Opsional: dipakai `prisma migrate` (koneksi langsung, tanpa pooler Neon)
DIRECT_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

NODE_ENV="development"
PORT=4000
CORS_ORIGIN="*"

# Minimal 32 karakter. Generate: openssl rand -base64 48
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

UPLOAD_DIR="uploads"
MAX_FOTO_SIZE_BYTES=2097152

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
